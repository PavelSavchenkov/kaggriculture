+void model_deposit_values(const agent::AgentObservation& dawn, const History& history, const DayMarket& market, const Options& options,
+                          const int output[N_PRODUCTS], int hours, double gain[N_PRODUCTS][HOURS]) {
+    for (int p : {int(STRAWBERRY), int(EGG), int(MILK), int(WOOL)}) {
+        const int c = output[p];
+        if (c <= 0) continue;
+        auto rollout = [&](int at) { return model_rollout(dawn, history, market, *options.sell_model, options.sell_tracker, p, c, at, hours); };
+        const double none = rollout(HOURS);
+        double at[HOURS];
+        int grid[HOURS], n = 0;
+        for (int h = 0; h < hours; h += market.grid_step) grid[n++] = h;
+        if (grid[n - 1] != hours - 1) grid[n++] = hours - 1;
+        for (int k = 0; k < n; ++k) at[k] = (rollout(grid[k]) - none) / c;
+        for (int k = 0; k + 1 < n; ++k)
+            for (int h = grid[k]; h <= grid[k + 1]; ++h) gain[p][h] = at[k] + (at[k + 1] - at[k]) * (h - grid[k]) / double(grid[k + 1] - grid[k]);
+        for (int h = 1; h < hours; ++h) gain[p][h] = std::min(gain[p][h], gain[p][h - 1]);
+        for (int h = 0; h < hours; ++h) gain[p][h] = std::max(0.0, gain[p][h]);
+    }
+}
