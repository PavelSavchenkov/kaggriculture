+// TEACHER_LABELS=2: M&M's label for day d translated onto our (diverged) groups as per-group rates. One-shot crops: option shares of
+// M&M's groups of the same crop and age (nearest age, else water only), moved to the closest allowed option when fixed. Ongoing
+// crops: retain / clear / fertilize / harvest shares by crop and age (else any age). Animals: feed / care / collect shares by
+// species. New crops / animals as M&M's; land keeps our quadrant count in step with M&M's. New crops are trimmed (largest first)
+// while they exceed our free sites. Empty optional when no valid intent results.
+std::vector<int> shares(const std::vector<double>& rate, int n) {  // n split by rates, largest remainder
+    std::vector<int> out(rate.size(), 0);
+    double total = 0;
+    for (double r : rate) total += r;
+    if (total <= 0 || n <= 0) return out;
+    std::vector<std::pair<double, int>> rest;
+    int used = 0;
+    for (size_t o = 0; o < rate.size(); ++o) {
+        const double x = n * rate[o] / total;
+        out[o] = int(x), used += out[o];
+        rest.push_back({x - out[o], int(o)});
+    }
+    std::sort(rest.begin(), rest.end(), std::greater<>());
+    for (int k = 0; used < n; ++k, ++used) ++out[rest[k % rest.size()].second];
+    return out;
+}
