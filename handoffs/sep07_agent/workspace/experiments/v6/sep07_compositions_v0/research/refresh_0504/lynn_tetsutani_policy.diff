+                continue
+            quantity = max(0, int(projected_shed.get(item, 0) or 0))
+            if quantity <= 0:
+                continue
+            order[2] = quantity
+            covered.add(item)
+        result.append(order)
+    missing = [(max(0, int(projected_shed.get(item, 0) or 0)) * max(1, int(prices.get(item, 1) or 1)), item) for item in PRODUCTS if item not in covered and int(projected_shed.get(item, 0) or 0) > 0]
+    missing.sort(key=lambda row: (-row[0], row[1]))
+    for _value, item in missing:
+        if len(result) >= MAX_ORDERS:
+            break
+        result.append(['SELL', item, max(0, int(projected_shed[item]))])
+        covered.add(item)
+    return result
