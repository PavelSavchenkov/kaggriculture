+// sellmodel (dc12): deposit values from the learned seller's own decisions, so the routes value stock the way the live seller will
+// sell it. Same objective as return_value: c units reach the shed at hour `at` (at >= hours: after the last market, kept overnight);
+// value = our revenue - rival_weight x the opponent's revenue at the forecast flow + the kept units at hold_discount x the price after
+// hold_steps of the next day. The model decides each hour's lot (threshold decode) on the dawn features with this product's shed, units
+// sold today, field, market inventory and price updated hour by hour (drains, the forecast opponent flow, our lots) and a copy of the
+// game's tracker for the level inputs.
+double model_rollout(const agent::AgentObservation& dawn, const History& history, const DayMarket& market, const bcsell::Model& m,
+                     const bcsell::Tracker* live, int p, int c, int at, int hours) {
+    const bcsell::Raw r0 = bcsell::raw_from(dawn, history, nullptr);
+    bcsell::Tracker t;
+    if (live) t.past.assign(live->past.end() - std::min<ptrdiff_t>(live->past.size(), 25), live->past.end()), t.last_step = live->last_step;
+    const bool terminal = dawn.day == LAST_DAY;
+    const int hold = market.hold_best ? HOURS : market.hold_steps;
+    int demand[2 * HOURS]{};
+    demand_by_step(dawn, p, hours + hold, demand);
+    auto opp = [&](int k) { return int(std::lround(std::max(0.0, market.rival[(dawn.step + k) % HOURS][p]))); };
+    std::vector<int> flow(24 + hours, 0);  // the opponent's units: the last 24 h from History, then the forecast
+    for (int j = 1; j <= 24 && dawn.step - j >= 0; ++j) flow[24 - j] = std::max(0, history.flow_at(dawn.step - j, p));
+    int inv = dawn.market.inventory[p], stock = dawn.own.shed[p], sold = 0;
+    double value = 0;
+    float x[bcsell::IN_LEVEL_CAP];
+    std::vector<double> pr(m.k + 1);
+    for (int k = 0; k < hours; ++k) {
+        // The deposit hour: the units are still in the pockets when the seller looks (M&M sells on arrival; the model keys on the
+        // pockets) and sellable this hour (worker actions run before market orders).
+        bcsell::Raw r = r0;
+        r.hour = k, r.shed[p] = stock, r.sold_today[p] = sold, r.inv[p] = inv, r.price[p] = market_price(p, inv);
+        r.shed_total += stock - dawn.own.shed[p];
+        if (k == at) r.pocket[p] += c, r.pocket_total += c, stock += c;
+        r.field[p] = std::max(0, r0.field[p] - (k >= at ? c : 0));
+        r.opp1[p] = flow[24 + k - 1], r.opp4[p] = r.opp24[p] = 0;
+        for (int j = 1; j <= 24; ++j) r.opp24[p] += flow[24 + k - j], r.opp4[p] += j <= 4 ? flow[24 + k - j] : 0;
+        if (bcsell::has_level(m.in)) {
+            std::array<double, 2 * N_PRODUCTS> e;
+            for (int q = 0; q < N_PRODUCTS; ++q) e[q] = dawn.market.inventory[q], e[N_PRODUCTS + q] = dawn.market.prices[q];
+            e[p] = inv, e[N_PRODUCTS + p] = r.price[p];
+            if (k > 0 || t.last_step != dawn.step) t.past.push_back(e);
+            t.last_step = dawn.step + k;
+            t.levels(r);
+        }
+        bcsell::features(r, p, x, m.in);
+        m.probs(x, pr.data());
+        int q = 0;
+        if (1 - pr[0] > m.thresholds.at(p)) {
+            double lot = 0;
+            for (int u = 1; u <= m.k; ++u) lot += u * pr[u];
+            q = std::min(stock, std::max(1, int(std::lround(lot / (1 - pr[0])))));
+        }
+        const int o = opp(k);
+        if (std::getenv("DC12_MDVLOG")) std::fprintf(stderr, "mdv,%d,%d,%d,%d,%d,%d,%.3f,%.3f,%d,%d,%.1f\n", dawn.day, p, c, at, k, stock, 1 - pr[0], m.thresholds.at(p), q, inv, value);
+        for (int j = 0; j < q; ++j) value += market_price(p, inv + j + (market.interleave ? std::min(j, o) : 0));
+        if (!terminal)
+            for (int j = 0; j < o; ++j) value -= market.rival_weight * market_price(p, inv + j + (market.interleave ? std::min(j, q) : q));
+        stock -= q, sold += q;
+        inv += q + o - demand[k];
+        flow[24 + k] = o;
+    }
+    const int left = stock + (at >= hours ? c : 0);
+    if (!terminal && left > 0) {
+        for (int k = hours; k < hours + hold; ++k) inv += opp(k) - demand[k];
+        value += market.hold_discount * sale_value(p, inv + market.hold_supply[p], left);
+    }
+    return value;
+}
